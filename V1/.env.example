# Roam — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Supabase — find these in your Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mapbox — find these in your Mapbox account > Access Tokens
# EXPO_PUBLIC_MAPBOX_TOKEN: public token (pk.*) used at runtime for map rendering
# MAPBOX_DOWNLOADS_TOKEN: secret token (sk.*) used at BUILD TIME only to download
#   the Mapbox SDK from their private Maven/CocoaPods repos. Required for EAS Build
#   and local `expo prebuild`. Never needed for Expo Go (which can't run Mapbox).
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here
MAPBOX_DOWNLOADS_TOKEN=sk.your-secret-mapbox-downloads-token-here
