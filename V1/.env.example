# Roam — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Supabase — find these in your Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mapbox — find this in your Mapbox account > Access Tokens
# Only needed for Phase 8 (Map Screen)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here
