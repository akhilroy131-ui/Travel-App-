# Roam — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Supabase — find these in your Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps — create a restricted key for the Android/iOS Maps SDKs
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
